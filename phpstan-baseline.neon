# Two entries, and they are the same finding: a trait the kernel PUBLISHES and its consumers use
# from outside this repo. `ChainsTraitMethods` is exercised by `tests/` (not an analysed path);
# `HandlesRunnerIo` is used by `rushing/laravel-popcorn-bubble`'s `BwrapRunner` and
# `rushing/laravel-popcorn-wasm`'s `WasmtimeRunner` — checked live, 2026-08-26. `trait.unused` reads
# "not analysed", not "dead": it is a MEASUREMENT gap at a package boundary, which is this ticket's
# own thesis pointed back at itself, and no edit inside `src/` can close it.
#
# Everything else is gone. 38 → 21 (ticket 46) → 2 (ticket 50), by fixing contracts, not by widening.
# A ratchet a feature can widen is not a ratchet.
parameters:
	ignoreErrors:
		-
			message: '#^Trait Rushing\\Popcorn\\Concerns\\ChainsTraitMethods is used zero times and is not analysed\.$#'
			identifier: trait.unused
			count: 1
			path: src/Concerns/ChainsTraitMethods.php

		-
			message: '#^Trait Rushing\\Popcorn\\Runner\\Concerns\\HandlesRunnerIo is used zero times and is not analysed\.$#'
			identifier: trait.unused
			count: 1
			path: src/Runner/Concerns/HandlesRunnerIo.php
