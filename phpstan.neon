includes:
    - phpstan-baseline.neon

parameters:
    paths:
        - src/
        # ANALYSED, not run. `tests/Static/` holds no test — it holds the kernel's own consumer of the
        # `@template TEntry` generics it publishes, written so that the analysis fails if the generic
        # stops flowing. The rest of `tests/` is deliberately absent: it would add 42 findings of
        # test-fixture noise to a ratchet that exists to hold the CONTRACT (ticket 50).
        - tests/Static/

    # The estate's six analysing hosts run larastan at level 7. This kernel is
    # framework-free (`mustNotRequire: illuminate/*`), so it takes plain phpstan —
    # and being framework-free it can afford to run STRICTER than its consumers,
    # which is the point: a wrong `@template` published from here is read by every
    # host that analyses, so popcorn's own annotations must be checked hardest.
    level: 8
