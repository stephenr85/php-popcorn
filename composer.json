{
    "name": "rushing/php-popcorn",
    "description": "Framework-free core for transport-agnostic invocable capabilities and self-validating strategy ladders — the invocable kernel behind rushing/laravel-popcorn.",
    "keywords": ["invocable", "strategy", "capability", "registry", "binding"],
    "license": "proprietary",
    "authors": [
        {
            "name": "Stephen Rushing",
            "email": "stephenr85@gmail.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "symfony/finder": "^6.0|^7.0|^8.0"
    },
    "require-dev": {
        "laravel/pint": "^1.0",
        "pestphp/pest": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "Rushing\\Popcorn\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Rushing\\Popcorn\\Tests\\": "tests/"
        }
    },
    "extra": {
        "package-topology": {
            "mustNotRequire": ["illuminate/*"]
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "pint": "@php -d memory_limit=512M vendor/bin/pint",
        "test": "@php vendor/bin/pest"
    }
}
